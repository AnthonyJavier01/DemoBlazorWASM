@page "/unauthorized"
@inject NavigationManager NavigationManager
@layout EmptyLayout

<div class="unauthorized">

    <div class="box">

        <div class="img">
            <img src="https://cdn-icons-png.flaticon.com/512/18240/18240766.png"
                 alt="Acceso denegado">
        </div>

        <div class="info">

            <h1>403</h1>

            <h2>Acceso denegado</h2>

            <p>
                No tienes permisos para acceder a esta página.
                Contacta al administrador si crees que es un error.
            </p>

            <FluentButton @onclick='() => NavigationManager.NavigateTo("/")' IconEnd="@(new Icons.Regular.Size16.Globe())"
                          Appearance="Appearance.Accent">
                Inicio
            </FluentButton>

        </div>

    </div>

</div>